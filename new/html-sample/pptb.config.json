{
    "invocation": {
        "version": "1.0.0",
        "capabilities": [
            "fetchxml"
        ],
        "prefill": {
            "properties": {
                "entityName": {
                    "type": "string"
                }
            }
        },
        "returnTopic": {
            "properties": {
                "entityName": {
                    "type": "string"
                },
                "fetchXml": {
                    "type": "string"
                },
                "recordCount": {
                    "type": "number"
                },
                "records": {
                    "type": "array"
                }
            }
        }
    },
    "agents": {
        "version": "1.0.0",
        "invokable": true,
        "modes": [
            "two-way"
        ],
        "defaultMode": "two-way",
        "timeoutMS": 60000,
        "headless": true,
        "executionModes": [
            "windowed",
            "headless"
        ],
        "defaultExecutionMode": "headless",
        "headlessEntry": "dist/headless.js"
    }
}