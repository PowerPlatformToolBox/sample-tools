{
    "workers": {
        "sample": {
            "kind": "dotnet-tool",
            "packageId": "PPTB.Sample.Query.Worker",
            "packageVersion": "0.1.6",
            "command": "pptb-sample-query-worker",
            "dotnet": {
                "targetFramework": "net10.0",
                "minimumRuntimeVersion": "10.0.0",
                "rollForward": "Major"
            },
            "platforms": [
                "all"
            ]
        }
    },
    "invocation": {
        "version": "1.0.0",
        "capabilities": [
            "fetchxml"
        ],
        "prefill": {
            "properties": {
                "entityName": {
                    "type": "string"
                },
                "fetchXml": {
                    "type": "string"
                }
            }
        },
        "returnTopic": {
            "properties": {
                "entityName": {
                    "type": "string"
                },
                "fetchXml": {
                    "type": "string"
                },
                "totalAccounts": {
                    "type": "number"
                },
                "countries": {
                    "type": "array"
                },
                "records": {
                    "type": "array"
                }
            }
        }
    },
    "agents": {
        "version": "1.0.0",
        "invokable": true,
        "modes": [
            "two-way"
        ],
        "defaultMode": "two-way",
        "timeoutMS": 60000,
        "headless": true,
        "executionModes": [
            "windowed",
            "headless"
        ],
        "defaultExecutionMode": "headless",
        "headlessEntry": "dist/headless.js"
    }
}